DATABASE_URL=postgresql+asyncpg://daily:daily_dev@localhost:5432/daily
VAULT_KEY=  # Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"  # must be exactly 32 ASCII chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=

# LiveKit (dev defaults — production uses real values)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret  # dev only — use a strong secret in production (min 32 chars)

# Production-only (leave blank for dev)
TURN_SECRET=
TURN_REALM=

# Magic-link email delivery via Resend (Phase 19 / D-02)
RESEND_API_KEY=
RESEND_FROM_EMAIL=dAIly <noreply@yourdomain.com>
MAGIC_LINK_BASE_URL=https://yourdomain.com

# Universal Links — Apple App Site Association (Phase 19 / D-03)
APPLE_TEAM_ID=  # 10-char Apple Developer Team ID (e.g. ABCD1234EF)
APPLE_BUNDLE_ID=com.daily.ios

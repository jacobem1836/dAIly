# ============================================================
# dAIly — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in the values marked REQUIRED.
# Variables with defaults shown can be left as-is for local dev.
# Generate a VAULT_KEY with:
#   python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Async URL used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://daily:daily_dev@localhost:5432/daily

# Sync URL used by Alembic migrations and psycopg2-based tools
DATABASE_URL_PSYCOPG=postgresql://daily:daily_dev@localhost:5432/daily

# ── Cache ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────
# REQUIRED: 32-byte base64 AES-256 key that encrypts OAuth tokens at rest.
# Generate with: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
VAULT_KEY=  # REQUIRED

# REQUIRED: Random secret for signing auth JWTs.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=  # REQUIRED

# ── LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...   # REQUIRED

# ── STT / TTS ────────────────────────────────────────────────
DEEPGRAM_API_KEY=   # REQUIRED (Speech-to-Text via Deepgram Nova-3)
CARTESIA_API_KEY=   # REQUIRED (Text-to-Speech via Cartesia Sonic-3)

# ── LiveKit ──────────────────────────────────────────────────
# IMPORTANT: LIVEKIT_URL must be a wss:// address reachable from mobile
# devices — NOT ws://localhost:7880. iOS clients and the agent worker must
# both point at the same server. Use your LiveKit Cloud URL or a publicly
# accessible tunnel (e.g. wss://your-project.livekit.cloud).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Integrations — Google OAuth ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Integrations — Microsoft OAuth ───────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=

# ── Integrations — Slack OAuth ────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Email / Magic-link ────────────────────────────────────────
RESEND_API_KEY=   # REQUIRED (magic-link email delivery via Resend)
RESEND_FROM_EMAIL=dAIly <noreply@example.com>
MAGIC_LINK_BASE_URL=https://app.example.com

# ── Mobile — Universal Links / AASA ──────────────────────────
# APPLE_TEAM_ID: 10-char Team ID from https://developer.apple.com/account -> Membership
# APPLE_BUNDLE_ID must match the Xcode bundle identifier for the dAIly target.
# Without these, /.well-known/apple-app-site-association returns a malformed appID
# and iOS will silently refuse to open magic-link Universal Links.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.daily.ios

# ── Briefing ─────────────────────────────────────────────────
BRIEFING_EMAIL_TOP_N=5

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

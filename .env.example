# Copy to .env and fill in real values. Never commit .env — it is
# gitignored. Every value below is a placeholder; none are real secrets.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://daily:daily_dev@localhost:5432/daily
DATABASE_URL_PSYCOPG=postgresql://daily:daily_dev@localhost:5432/daily
# Dev-only compose defaults (docker-compose.yml). Override for anything
# beyond a throwaway local instance.
POSTGRES_PASSWORD=daily_dev

# --- Cache ---
REDIS_URL=redis://:daily_dev_redis@localhost:6379/0
# Dev-only compose default (docker-compose.yml).
REDIS_PASSWORD=daily_dev_redis

# --- Vault (OAuth token encryption at rest) ---
VAULT_KEY=  # Generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"

# --- App JWT auth ---
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# --- OAuth integrations ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=

# --- LLM / voice pipeline ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- LiveKit (voice transport) ---
# livekit_url must be a wss:// address reachable from mobile devices — NOT
# ws://localhost:7880. See docs/runbook/livekit-worker.md.
LIVEKIT_URL=wss://CHANGE_ME.livekit.cloud
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# --- TURN relay (docker-compose.prod.yml coturn service) ---
# scripts/coturn-entrypoint.sh refuses to start if either is left unset or
# equal to the literal placeholder tokens baked into turnserver.conf
# (REPLACE_TURN_SECRET / REPLACE_DOMAIN) — set real values below.
TURN_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
TURN_REALM=CHANGE_ME.example.com

# --- Reverse proxy / TLS (docker-compose.prod.yml caddy service) ---
DOMAIN=CHANGE_ME.example.com

# --- Magic-link email delivery (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=dAIly <noreply@example.com>
MAGIC_LINK_BASE_URL=https://app.example.com

# --- Universal Links / AASA (D-02, Phase 21.2) ---
# APPLE_TEAM_ID is the 10-char Team ID from https://developer.apple.com/account -> Membership.
# APPLE_BUNDLE_ID must match the Xcode bundle identifier for the dAIly target.
# Without these, /.well-known/apple-app-site-association returns a malformed appID
# and iOS will silently refuse to open magic-link Universal Links.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.daily.ios

# --- Android App Links (Phase 20 / MOB-02) ---
ANDROID_PACKAGE_NAME=com.daily.android
ANDROID_SHA256_FINGERPRINT=

# --- Briefing ---
BRIEFING_EMAIL_TOP_N=5

# --- Logging ---
LOG_LEVEL=INFO
